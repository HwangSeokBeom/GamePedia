{
  "permissions": {
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "Bash(pwd)",
      "Bash(ls:*)",
      "Bash(find .:*)",
      "Bash(rg:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(sh -n:*)",
      "Bash(./scripts/verify-system:*)",
      "Bash(./scripts/verify-integrations:*)",
      "Bash(./scripts/verify-auth:*)",
      "Bash(./tests/integrations.sh:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run type-check:*)",
      "Bash(./gradlew build:*)",
      "Bash(./gradlew lint:*)",
      "Bash(./gradlew test:*)",
      "Bash(xcodebuild -list:*)",
      "Bash(xcodebuild * build:*)",
      "Bash(xcodebuild * test:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*credential*)",
      "Read(./**/*token*)",
      "Read(./**/*cookie*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(security:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)"
    ]
  }
}
